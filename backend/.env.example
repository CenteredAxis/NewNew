# Copy to .env and adjust values.

# Base URL of the upstream OpenAI-compatible endpoint.
# The frontend also sends X-Endpoint-Url per request, so this is the fallback.
LLM_ENDPOINT_URL=http://localhost:11434

# Optional API key forwarded to the upstream endpoint.
LLM_API_KEY=

# PostgreSQL connection URL (async driver).
# The default matches the docker-compose.dev.yml credentials.
DATABASE_URL=postgresql+asyncpg://keystone:keystone@localhost:5432/keystone
